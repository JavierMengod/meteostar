{
  "name": "meteostar",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types",
    "db:migrar:local": "wrangler d1 migrations apply meteostar --local",
    "db:migrar": "wrangler d1 migrations apply meteostar --remote"
  },
  "description": "Web de la estación meteorológica de Villastar (Teruel) sobre Cloudflare Workers",
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "hono": "^4.13.18",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.0"
  },
  "private": true,
  "type": "module"
}
