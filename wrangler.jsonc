{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meteostar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Cada minuto: estaciones por API y limpieza horaria. Cada 10 minutos: satélite (min 3) y archivo del radar (min 8)
  "triggers": { "crons": ["* * * * *", "3-59/10 * * * *", "8-59/10 * * * *", "1-59/2 * * * *", "5-59/10 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meteostar",
      // Se rellena al crear la base de datos con: npx wrangler d1 create meteostar
      "database_id": "9e4c64e8-e9b9-4e43-9c08-b62fb2e5e601",
      "migrations_dir": "migrations"
    }
  ],
  // Imágenes del satélite ya descargadas (caducan solas a las 4 horas)
  "kv_namespaces": [
    {
      "binding": "IMAGENES",
      // Se rellena al crearlo con: npx wrangler kv namespace create IMAGENES
      "id": "aa0a37a900eb4343b9f736d92c0cb594"
    }
  ],
  // Datos de la red que se muestran en la portada (la previsión principal es la de este punto)
  "vars": {
    "RED_NOMBRE": "Meteostar",
    "RED_TITULO": "El Tiempo en Villastar",
    "RED_SUBTITULO": "Red de estaciones meteorológicas de Villastar y la vega del Turia (Teruel)",
    "RED_LUGAR": "Villastar",
    "RED_LAT": "40.284",
    "RED_LON": "-1.158",
    "RED_ALTITUD": "935"
  }
}
